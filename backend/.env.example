DATABASE_URL=sqlite:///./digital_twin.db
# Replace with a long, random value before running outside local development.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:15173,http://localhost:15173
UPLOAD_DIR=uploads
# Production uses Neon-backed document bytes by default. Keep R2 variables empty unless
# an existing private R2 bucket is intentionally configured.
APP_ENV=development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
